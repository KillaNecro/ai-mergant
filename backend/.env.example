# AI Merchant OS Lite - Backend Environment
# Copy this file to .env

# Optional: Gemini API key. If empty, the app runs in Demo Mode.
GEMINI_API_KEY=

# Optional: Gemini model to use (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Optional: SQLite database file path (default: ./merchant_os.db)
SQLITE_PATH=

# CORS origins (comma separated). Use * for open dev.
CORS_ORIGINS=*

# Import limits
IMPORT_MAX_FILE_MB=10
IMPORT_MAX_ROWS=10000
BULK_PRICE_PERCENT_LIMIT=90

# App environment (development | test | production). Affects WooCommerce SSRF policy.
APP_ENV=development

# WooCommerce integration (Phase 3A). Leave URL and keys blank in mock mode.
WOOCOMMERCE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
WOOCOMMERCE_MODE=mock
WOOCOMMERCE_TIMEOUT_SECONDS=20
WOOCOMMERCE_VERIFY_SSL=true
